# Copy to .env and adjust. Contains no secrets - never commit a real .env file.

# --- existing app settings ---
# MONGO_URL=mongodb://localhost:27017
# SECRET_KEY=change-me          # REQUIRED in real use; the default in main.py is insecure
# OLLAMA_URL=http://localhost:11434
# MODEL_NAME=mistral:latest

# --- RAG guideline verification (all optional; defaults shown) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest            # reuse the model your doctor agent already uses
RAG_LLM_TIMEOUT=90                     # seconds to wait for Ollama before giving up

# Embeddings: auto | sentence-transformers | ollama | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_EMBED_MODEL=nomic-embed-text    # only for EMBEDDING_BACKEND=ollama

# Knowledge base
GUIDELINE_PDF_DIR=medical_guidelines/pdfs
GUIDELINE_SOURCES_FILE=medical_guidelines/sources.json
VECTOR_BACKEND=auto                    # auto | chroma | local
CHROMA_PERSIST_DIR=chroma_db

# Chunking and retrieval
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.30
RAG_MAX_SOURCE_AGE_YEARS=10

# Verification judge: ollama (LLM) | heuristic (keyword/negation rules, no LLM, low assurance)
VERIFIER_JUDGE=ollama

# OCR for scanned PDFs (needs Tesseract installed): true | false
RAG_OCR_ENABLED=false
